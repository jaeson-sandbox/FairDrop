      "link": null,
      "locked": false,
      "index": "cF",
      "text": "SECOND INSTANCE\nLaunching FairDrop again restores / unminimizes the existing window and preserves whichever live session surface is active. It never replaces the session.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 67,
      "containerId": null,
      "originalText": "SECOND INSTANCE\nLaunching FairDrop again restores / unminimizes the existing window and preserves whichever live session surface is active. It never replaces the session.",
