      "isDeleted": false,
      "boundElements": null,
      "updated": 1787486400000,
      "link": null,
      "locked": false,
      "index": "cD",
      "text": "ACCESSIBILITY FLOOR\nVisible focus on every semantic action. Predictable focus after each backend-authoritative state change. aria-live announces transfer start, terminal outcome, validation error, and reset. Reduced motion preserves meaning.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 67,
      "containerId": null,
      "originalText": "ACCESSIBILITY FLOOR\nVisible focus on every semantic action. Predictable focus after each backend-authoritative state change. aria-live announces transfer start, terminal outcome, validation error, and reset. Reduced motion preserves meaning.",
      "lineHeight": 1.25,
      "autoResize": false
    },
