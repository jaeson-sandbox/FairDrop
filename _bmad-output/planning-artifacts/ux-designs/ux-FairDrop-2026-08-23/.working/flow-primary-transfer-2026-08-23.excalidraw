      "link": null,
      "locked": false,
      "index": "cH",
      "text": "TERMINAL LEASE\nDone and Error are backend-authoritative, announced states. They normally remain visible for ~3 seconds, but only transfer-reset returns the UI to Idle; animations and frontend timers do not.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 52,
      "containerId": null,
      "originalText": "TERMINAL LEASE\nDone and Error are backend-authoritative, announced states. They normally remain visible for ~3 seconds, but only transfer-reset returns the UI to Idle; animations and frontend timers do not.",
      "lineHeight": 1.25,
      "autoResize": false
    },
