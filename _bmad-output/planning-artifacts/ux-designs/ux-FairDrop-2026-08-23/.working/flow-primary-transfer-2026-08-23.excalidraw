      "updated": 1787486400000,
      "link": null,
      "locked": false,
      "index": "cB",
      "text": "CANCEL CONTRACT\nAvailable in Staged and Transferring. Before commit it quiesces resources; after commit a started/progress prefix ends in reset — never a false completion or cancellation-as-error.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 52,
      "containerId": null,
      "originalText": "CANCEL CONTRACT\nAvailable in Staged and Transferring. Before commit it quiesces resources; after commit a started/progress prefix ends in reset — never a false completion or cancellation-as-error.",
      "lineHeight": 1.25,
      "autoResize": false
    },
